---
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import "../../styles/docs.css";
import { allDocs, description, label } from "../../lib/docs";
import { sections } from "../../lib/site";

const docs = await allDocs();
const byId = new Map(docs.map((d) => [d.id, d]));
const intro = "Run Byname yourself or on Unkey, choose where your questions are asked, connect Search Console, and give your agents access.";
---
<Base title="Documentation · Byname docs" description={intro} path="/docs/" type="article" markdown="/llms.txt" bodyClass="docs" docs>
  <main class="wrap docs-layout" id="main">
    <DocsSidebar docs={docs} />
    <article class="docs-main">
      <p class="docs-kicker">Docs</p>
      <div class="prose">
        <h1>Documentation</h1>
        <p class="lede-doc">{intro}</p>
      </div>
      {sections.map((s) => (
        <>
          <h2 class="index-title">{s.title}</h2>
          <div class="index-grid">
            {s.pages.map((id) => (
              <a class="index-card" href={`/docs/${id}`}>
                <span class="index-name">{label(byId.get(id)!)}</span>
                <span class="index-desc">{description(byId.get(id)!)}</span>
              </a>
            ))}
          </div>
        </>
      ))}
    </article>
    <aside class="docs-toc" aria-label="On this page"></aside>
  </main>
</Base>
